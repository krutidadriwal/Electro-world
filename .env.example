# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SERVER_BASE_URL: Base URL of the deployed Vercel backend (no trailing slash), e.g. https://electro-world-server.vercel.app
SERVER_BASE_URL=https://REPLACE_WITH_YOUR_VERCEL_URL.vercel.app

# Used by :staffapp only, to call Supabase Auth directly for staff (admin/
# employee) login. Supabase dashboard -> Project Settings -> API. The anon
# key is public-safe (same key Supabase's own client SDKs ship with).
SUPABASE_URL=https://REPLACE_WITH_YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_SUPABASE_ANON_KEY

# Store details shown on the "Visit Store" dashboard tab (address, map link, contact).
STORE_NAME=Electro World
STORE_ADDRESS=Enter your store address here
STORE_PHONE=+91 00000 00000
STORE_WORKING_HOURS=10:00 AM - 09:00 PM
STORE_LATITUDE=0.0
STORE_LONGITUDE=0.0
