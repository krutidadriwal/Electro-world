# Supabase transaction pooler connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> "Transaction" mode.
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Google Drive folder ID that contains one subfolder per user (each subfolder
# named after the user's 10-digit phone number, holding their invoice PDFs).
DRIVE_ROOT_FOLDER_ID=

# Service account used to access Google Drive server-side -- the full JSON
# key file's contents, as a single-line string. No refresh token, no expiry:
# Google Cloud Console -> IAM & Admin -> Service Accounts -> (account) ->
# Keys -> Add key -> JSON, then share DRIVE_ROOT_FOLDER_ID with the service
# account's client_email (Editor access) in Google Drive. Only used for
# invoices now -- notification images are Supabase Storage (see below), since
# a bare service account has no storage quota to upload new files with.
GOOGLE_SERVICE_ACCOUNT_JSON=

# TextBee (textbee.dev) gateway used to send OTP SMS via a spare Android
# phone. TextBee dashboard -> your device -> API key / device ID.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Only needed if self-hosting TextBee's backend instead of using the free
# hosted api.textbee.dev service.
TEXTBEE_BASE_URL=

# Random secret used to sign session tokens (after PIN login/setup) and
# short-lived OTP-verification tokens (after verify-otp, before set-pin).
# Generate once with: openssl rand -base64 48
JWT_SECRET=

# Supabase project URL and keys, used for staff (admin/employee) auth --
# separate from the customer phone+PIN auth above.
# Supabase dashboard -> Project Settings -> API.
#
# Staff access tokens are verified against SUPABASE_URL's published JWKS
# (.../auth/v1/.well-known/jwks.json) via lib/staffAuth.js -- this project's
# Supabase instance signs tokens asymmetrically (ES256), so no separate JWT
# secret is needed for verification, only the project URL.
SUPABASE_URL=

# Also used server-side (lib/notificationImages.js) to upload notification
# images to the "notification-images" Storage bucket -- create it once via
# Supabase dashboard -> Storage -> New bucket, Public. The service role key
# bypasses RLS/policies entirely, same as it does for the DB pool.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Service account used to send push notifications via FCM -- its own,
# dedicated Firebase project (not the Drive service account/project above).
# Create a fresh Firebase project, register the customer Android app in it
# (get a new app/google-services.json from there), then: Firebase Console ->
# Project Settings -> Service Accounts -> Generate new private key. Paste the
# full JSON key file's contents here as a single-line string.
FIREBASE_SERVICE_ACCOUNT_JSON=
