# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# DEVELOPER_MODE_BYPASS: Set to "true" to enable developer bypass on the Login screen, or "false" to require normal OTP verification.
DEVELOPER_MODE_BYPASS=false

# Store details shown on the "Visit Store" dashboard tab (address, map link, contact).
STORE_NAME=Electro World
STORE_ADDRESS=Enter your store address here
STORE_PHONE=+91 00000 00000
STORE_WORKING_HOURS=10:00 AM - 09:00 PM
STORE_LATITUDE=0.0
STORE_LONGITUDE=0.0
