<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- 1. Centered Circle with a rich metallic gold gradient -->
    <path
        android:pathData="M 54 29 A 25 25 0 1 1 53.99 29 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="29"
                android:startY="79"
                android:endX="79"
                android:endY="29"
                android:type="linear">
                <item android:offset="0.0" android:color="#7F5B2F" />
                <item android:offset="0.5" android:color="#D4A359" />
                <item android:offset="1.0" android:color="#F2D19A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. Main Diagonal Gold Bar extending from bottom-left to top-right -->
    <path
        android:pathData="M 14.0,69.3 L 94.0,38.7"
        android:strokeWidth="9.5"
        android:strokeLineCap="butt">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="14.0"
                android:startY="69.3"
                android:endX="94.0"
                android:endY="38.7"
                android:type="linear">
                <item android:offset="0.0" android:color="#7F5B2F" />
                <item android:offset="0.5" android:color="#D4A359" />
                <item android:offset="1.0" android:color="#F2D19A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. Parallel cutout lines drawn in the brand's slate-charcoal color to sever the pieces -->
    <!-- Cutout 1: Upper Slash (parallel to bar with -0.383 slope) -->
    <path
        android:pathData="M -6.0,68.9 L 114.0,23.0"
        android:strokeColor="#1E2022"
        android:strokeWidth="4.5"
        android:strokeLineCap="butt" />

    <!-- Cutout 2: Lower Slash (parallel to bar with -0.383 slope) -->
    <path
        android:pathData="M -6.0,85.0 L 114.0,39.1"
        android:strokeColor="#1E2022"
        android:strokeWidth="4.5"
        android:strokeLineCap="butt" />
</vector>
