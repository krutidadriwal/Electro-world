# Supabase transaction pooler connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> "Transaction" mode.
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Google Drive folder ID that contains one subfolder per user (each subfolder
# named after the user's 10-digit phone number, holding their invoice PDFs).
DRIVE_ROOT_FOLDER_ID=

# OAuth client used to refresh the Google Drive access token server-side.
# Google Cloud Console -> APIs & Services -> Credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Long-lived refresh token obtained once via the OAuth consent flow for the
# Google account that owns/has access to DRIVE_ROOT_FOLDER_ID.
GOOGLE_OAUTH_REFRESH_TOKEN=

# Firebase project used for Phone Auth OTP verification (Android app talks to
# Firebase directly; the server only verifies the resulting ID token).
# Firebase Console -> Project Settings -> General -> Project ID.
FIREBASE_PROJECT_ID=
# Firebase Console -> Project Settings -> Service Accounts -> Generate new
# private key. Paste the downloaded JSON here as a single line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Random secret used to sign session tokens issued after PIN login/setup.
# Generate once with: openssl rand -base64 48
JWT_SECRET=
